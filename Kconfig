menu "Unit Light Configuration"

    config UNIT_LIGHT_ADC_SAMPLES
        int "ADC samples averaged per reading"
        range 1 64
        default 16
        help
            Number of calibrated ADC readings averaged by unit_light_read().
            More samples reduce ESP32 ADC noise at the cost of a longer read.

endmenu
